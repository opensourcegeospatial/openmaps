###############################################################################
# OpenMaps – oppsett
#
# Kopier denne filen til .env og start:
#
#     cp .env.example .env
#     docker compose up -d
#
# Linjene under «Hurtigstart» er nok til å prøve OpenMaps mot de offentlige
# OpenStreetMap-tjenestene. Alle andre variabler er kommentert ut og viser
# standardverdien: fjern # foran linjen for å endre den.
#
# Skriv verdier med mellomrom eller parenteser i anførselstegn. JSON-verdier
# (MAP_STYLES) skrives i enkle anførselstegn.
###############################################################################

# =============================================================================
# Hurtigstart: de offentlige tjenestene
# =============================================================================
# Oppsettet under er ment for å prøve OpenMaps ut. Tjenestene er gratis, men har
# bruksgrenser og er ikke laget for fast drift eller mange samtidige brukere.
# Til vanlig bruk peker du variablene mot dine egne tjenester (se README).
#
# Søk og adresseoppslag: Nominatim hos OpenStreetMap.
# Maks én forespørsel i sekundet, og tjenesten krever at hver forespørsel sier
# hvem som sender den (HTTP_USER_AGENT under). Ikke egnet for masseoppslag.
# Vilkår: https://operations.osmfoundation.org/policies/nominatim/
GEOCODE_URL=https://nominatim.openstreetmap.org/search
REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse

# Ruter: GraphHopper. Tjenesten krever en API-nøkkel. Du får en gratis nøkkel på
# graphhopper.com. Gratisnivået har grenser for antall forespørsler per minutt
# og per døgn (se graphhopper.com for gjeldende grenser). Uten gyldig nøkkel
# får du en feilmelding i stedet for en rute.
GRAPHHOPPER_URL=https://graphhopper.com/api/1/route
GRAPHHOPPER_API_KEY=

# Kartobjekter og tekstsøk: Overpass. En delt tjeneste som forventer rimelig
# bruk. Er den travel, kan den avvise eller utsette spørringer.
# Mer om bruken: https://wiki.openstreetmap.org/wiki/Overpass_API
OVERPASS_API=https://overpass-api.de/api/interpreter

# Bakgrunnskartet er som standard fliser fra tile.openstreetmap.org (se
# MAP_STYLES lenger ned). Også den tjenesten er beregnet på lett bruk.
# Vilkår: https://operations.osmfoundation.org/policies/tiles/

# Helsesjekken (/health) spør hver tjeneste om den er oppe. Den hostede
# GraphHopper-tjenesten har ikke noe /health-endepunkt, så sjekken av den
# hoppes over (graphhopper i listen). Fjern graphhopper fra listen når du kjører
# din egen GraphHopper. Se «Backend: helsesjekk» lenger ned for navnene.
HEALTH_SKIP=tileserver,nominatim-ui,overpassbot,overpass-ultra,graphhopper-maps,graphhopper

# Hvem som sender forespørslene. De offentlige tjenestene avviser anonyme
# klienter og vil kunne ta kontakt hvis noe går galt. Bytt til din egen
# e-postadresse eller nettside.
HTTP_USER_AGENT="OpenMaps (+mailto:din-epost@example.org)"

# =============================================================================
# Bilder, porter og mapper
# =============================================================================

# Versjonen av de ferdige bildene (ghcr.io/opensourcegeospatial/openmaps-frontend og
# openmaps-backend). «latest» er siste utgave. Sett et versjonsnummer for å
# låse versjonen. Vil du bygge bildene selv, kjør «docker compose build».
# OPENMAPS_VERSION=latest

# Porten på maskinen din der kartet åpnes: http://localhost:8080
# FRONTEND_PORT=8080

# Porten på maskinen din for API-et (blant annet /health). API-et har ingen
# innlogging: ikke gjør porten tilgjengelig fra internett.
# BACKEND_PORT=8000

# Bygg backend med torch og transformers for den lokale modellen til tekstsøk.
# Bildet blir mye større. Gjelder bare når du bygger selv (docker compose build).
# BACKEND_WITH_ML=false

# Mappen på maskinen din med panoramabilder til gatebilder. Backend skriver
# panoramas.json her, så mappen må være skrivbar for brukeren i containeren
# (uid 1000).
# STREETVIEW_HOST_DIR=./streetview

# =============================================================================
# Backend: tjenester
# =============================================================================

# Kartfliseserveren som /health kan sjekke. Brukes bare hvis «tileserver»
# fjernes fra HEALTH_SKIP.
# TILESERVER_URL=http://tileserver:8080

# Språk for stedsnavn og adresser i søk og adresseoppslag (Nominatims
# accept-language). Norsk først, engelsk som siste utvei.
# NOMINATIM_LANGUAGE=nb,nn,no,en

# =============================================================================
# Backend: helsesjekk (/health)
# =============================================================================

# Sjekkene /health kan gjøre, og som kan hoppes over med HEALTH_SKIP (se
# Hurtigstart øverst): tileserver, nominatim, overpass, graphhopper,
# nominatim-ui, overpassbot, overpass-ultra, graphhopper-maps, llm. Uten
# HEALTH_SKIP i .env hopper compose.yml over kartfliseserveren og de valgfrie
# verktøytjenestene, som ikke er med her.

# Tidsgrense per sjekk, i sekunder.
# HEALTH_CHECK_TIMEOUT=5

# Hvor lenge et resultat gjenbrukes, i sekunder.
# HEALTH_CACHE_SECONDS=5

# =============================================================================
# Backend: logging og grenser
# =============================================================================

# Loggnivå: DEBUG, INFO, WARNING eller ERROR.
# LOG_LEVEL=INFO

# Loggformat: json (én JSON-linje per hendelse) eller text (lesbar tekst).
# LOG_FORMAT=json

# Flest alternative ruter som kan returneres (2–6).
# ROUTING_MAX_ALTERNATIVES=3

# Flest viapunkter i en rute (1–100).
# MAX_ROUTE_WAYPOINTS=25

# Største område et tekstsøk kan dekke, i kvadratgrader.
# OVERPASS_MAX_BBOX_AREA=4

# Største svar Overpass kan gi på et tekstsøk, i byte.
# OVERPASS_MAXSIZE_BYTES=33554432

# Hvor mange tekstsøk den lokale modellen kan kjøre samtidig (hvert tar en hel
# CPU-kjerne).
# OVERPASS_MAX_CONCURRENT_INFERENCES=1

# Lengste tid den lokale modellen får på ett tekstsøk, i sekunder.
# OVERPASS_MAX_GENERATION_SECONDS=30

# =============================================================================
# Backend: tekstsøk i kartobjekter
# =============================================================================
# Tekstsøket gjør en beskrivelse som «bensinstasjoner» om til en Overpass-
# spørring. Det kan gjøres av en språkmodell (LLM), av en lokal modell eller
# med enkelt nøkkelordsøk. Uten noen av delene bruker OpenMaps nøkkelordsøk.

# Hvilken som brukes: auto, llm, byt5 (den lokale modellen) eller keyword. auto
# bruker språkmodellen når LLM_BASE_URL, LLM_MODEL og LLM_API_KEY alle er satt,
# ellers den lokale modellen hvis den er lastet, ellers nøkkelordsøk.
# OVERPASS_GENERATOR=auto

# Språkmodell med OpenAI-kompatibelt chat-API, for eksempel
# https://llm.example.org/v1 (eller Ollamas /v1).
# LLM_BASE_URL=

# Navnet på modellen hos tjenesten, for eksempel llama3.1:8b.
# LLM_MODEL=

# API-nøkkelen. Den sendes bare som bearer-token og vises eller logges aldri.
# LLM_API_KEY=

# Tidsgrense for hele forespørselen, i sekunder. Etter det tar nøkkelordsøk over.
# LLM_TIMEOUT_SECONDS=30

# Flest tokens modellen kan svare med.
# LLM_MAX_TOKENS=200

# Flest forespørsler til språkmodellen samtidig.
# LLM_MAX_CONCURRENT=4

# Mappen i containeren med den lokale modellen. Krever BACKEND_WITH_ML=true og
# at linjen «./models:/app/models:ro» i compose.yml er aktivert.
# MODEL_DIR=/app/models/byt5-base_com08

# Antall tråder den lokale modellen bruker. Tomt gir én per CPU-kjerne
# containeren har tilgang til.
# TORCH_NUM_THREADS=

# =============================================================================
# Backend: gatebilder
# =============================================================================
# Gatebilder er av til du slår dem på (STREETVIEW_ENABLED lenger ned). Legg
# 360°-bilder (.jpg, .jpeg, .png eller .webp) i mappen panoramas/ under
# STREETVIEW_HOST_DIR, hvert med en .json-fil med samme navn ved siden av.
# Se README.

# Bygg panoramas.json ved oppstart når den mangler eller er eldre enn
# metadatafilene. Sett false bare for å feilsøke indeksen.
# STREETVIEW_INDEX_ON_START=true

# =============================================================================
# Frontend: kartet
# =============================================================================

# Startvisning: zoomnivå og midtpunkt. Standard er Oslo.
# MAP_DEFAULT_ZOOM=12
# MAP_DEFAULT_LNG=10.7446
# MAP_DEFAULT_LAT=59.9127

# Bakgrunnskart som JSON-liste med objekter på formen
# {id, name, url, attribution}. url bruker {z}, {x} og {y} (og eventuelt {s}).
# Skriv hele verdien i enkle anførselstegn. Standard er ett lag med
# OpenStreetMap-fliser; legg til flere objekter for flere lag, for eksempel
# fliser fra din egen kartfliseserver.
# MAP_STYLES='[{"id":"osm","name":"OpenStreetMap","url":"https://tile.openstreetmap.org/{z}/{x}/{y}.png","attribution":"© OpenStreetMap-bidragsytere"}]'

# Adressene nettleseren bruker mot API-et. Standard er relative stier som
# frontendens egen nginx sender videre til backend, så nettleseren holder seg på
# samme opprinnelse. Endres sjelden.
# API_GRAPHHOPPER_URL=/api/route
# API_NOMINATIM_SEARCH_URL=/api/search
# API_NOMINATIM_REVERSE_URL=/api/reverse
# API_OVERPASS_URL=/api/overpass

# Systemhelse-panelet for den som driver tjenesten. Det vises ikke av seg selv:
# åpne appen med ?health i adressen for å få en knapp, eller trykk Alt+Shift+H.
# Sett false for å slå det av.
# HEALTH_DASHBOARD_ENABLED=true

# =============================================================================
# Frontend: gatebilder
# =============================================================================

# Hovedbryteren. Sett true når du har lagt panoramabilder i STREETVIEW_HOST_DIR.
# false slår funksjonen helt av.
# STREETVIEW_ENABLED=false

# Hvor nettleseren henter punktene og bildene. Standard er backendens egne
# adresser.
# STREETVIEW_GEOJSON_URL=/api/streetview/panoramas
# STREETVIEW_PANORAMA_URL=/api/streetview/panorama/{id}

# STREETVIEW_TILES_URL og STREETVIEW_SOURCE_LAYER har ingen virkning i dette
# oppsettet. Kartet tegner ikke kartfliser med punktene. Fliseadressen brukes bare
# til å lage en GeoJSON-adresse når STREETVIEW_GEOJSON_URL er tom, og Compose
# fyller alltid inn den.
# STREETVIEW_TILES_URL=
# STREETVIEW_SOURCE_LAYER=panoramas

# Adresse for metadata om ett enkelt panorama. Tomt = ikke i bruk.
# STREETVIEW_METADATA_URL=

# Zoomnivåene punktene vises på, fra og med minste til og med største.
# STREETVIEW_MIN_ZOOM=12
# STREETVIEW_MAX_ZOOM=18

# Utseendet til punktene. Fargene er tomme som standard: da følger de temaet
# (THEME_PRIMARY).
# STREETVIEW_CIRCLE_COLOR=
# STREETVIEW_CIRCLE_RADIUS=6
# STREETVIEW_CIRCLE_STROKE_COLOR=
# STREETVIEW_CIRCLE_STROKE_WIDTH=2
# STREETVIEW_CIRCLE_OPACITY=0.85

# Området panoramaene ligger i: [vest, sør, øst, nord] i grader, for eksempel
# [10.6,59.85,10.9,59.97]. Gatebildene hentes bare når kartutsnittet overlapper
# området. Tomt = alltid.
# STREETVIEW_BOUNDS=

# =============================================================================
# Frontend: farger
# =============================================================================
# Alle verdier er fargekoder på formen #rrggbb (seks heksadesimale sifre).
# Tomme eller utelatte verdier gir den innebygde paletten. Velg en mørk nok
# farge til at hvit tekst er lesbar på knapper.

# Enkleste oppsett: sett bare THEME_PRIMARY. Den gir lyse og mørke nyanser for
# grensesnittet og styrer også ruten, startmarkøren og valgte objekter.
# THEME_PRIMARY=

# Statusfarger, hver med lyse og mørke nyanser.
# THEME_SUCCESS=
# THEME_DANGER=
# THEME_WARNING=

# Nøytrale flater i lyst tema. Mørkt tema beholder sine egne nøytrale farger.
# THEME_NEUTRAL=
# THEME_BACKGROUND=
# THEME_SURFACE=
# THEME_TEXT=
# THEME_BORDER=

# Kartgeometri. Overstyrer THEME_PRIMARY for hver enkelt del.
# THEME_ROUTE_PRIMARY=
# THEME_ROUTE_ALTERNATIVE=
# THEME_MARKER_FROM=
# THEME_MARKER_TO=
# THEME_MARKER_WAYPOINT=
# THEME_AVOID=
# THEME_FEATURE_SELECTED=
